# Copy to .env. One model key is enough; the CLI loads .env itself.
# Or no key at all: LOCAL_CLAUDE=1 runs every model call as a local Claude Code session on your own login.
LOCAL_CLAUDE=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional: SUBQ=1 runs the second Critic on subq-snap-1.1 (SUBQ_API_KEY), or on Jev with SUBQ_MODEL=jev-latest (TYPESAFE_API_KEY).
SUBQ=
SUBQ_API_KEY=
TYPESAFE_API_KEY=
# Optional: SCREEN=1 rates each need's candidates on the same decision model before profiling, and profiles only the most likely.
SCREEN=
# Optional: Mozaik Cloud telemetry (or run `npx @mozaik-ai/cloud-sdk pair`).
MOZAIK_API_KEY=
