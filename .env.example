# Copy to .env. One model key is enough; the CLI loads .env itself.
# Or no key at all: LOCAL_CLAUDE=1 runs every model call as a local Claude Code session on your own login.
LOCAL_CLAUDE=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Or SUBQ=1 with a SubQ key: every model call goes to SubQ's Chat Completions (subq-preview). Wins over LOCAL_CLAUDE.
SUBQ=
SUBQ_API_KEY=
# Optional: Mozaik Cloud telemetry (or run `npx @mozaik-ai/cloud-sdk pair`).
MOZAIK_API_KEY=
