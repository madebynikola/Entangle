{
  "name": "einstein-matchmaker",
  "version": "0.1.0",
  "private": true,
  "description": "EINSTEIN matchmaker: concurrent Mozaik agents that pair researchers with company challenges and write proposals",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server/main.ts dev",
    "replay": "tsx src/server/main.ts replay",
    "build": "vite build --config web/vite.config.ts && tsx src/server/export.ts",
    "start": "tsx src/server/main.ts start",
    "match": "tsx src/cli.ts",
    "critic:eval": "tsx src/critic-eval.ts",
    "critic:runs": "tsx src/critic-runs.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@hono/node-server": "2.1.5",
    "@mozaik-ai/core": "4.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "hono": "4.13.14",
    "lucide-react": "1.65.0",
    "motion": "14.8.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router": "8.5.1",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
